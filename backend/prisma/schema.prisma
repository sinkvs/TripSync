// Генератор клиента. Создаем Prisma Client для работы с базой данных из кода
generator client {
  provider = "prisma-client-js"
}

// Источник данных. Указываем, что база PostgreSQL и адрес берем из .env
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Таблица User
model User {
  id        Int      @id @default(autoincrement())      // первичный ключ, автоувеличение (1,2,3...)
  email     String   @unique                            // уникальный email, используем как логин
  password  String                                      // храним хеш пароля (не сам пароль)
  name      String                                      // имя пользователя
  createdAt DateTime @default(now())                    // дата и время создания записи, проставляем автоматически
  updatedAt DateTime @updatedAt                         // обновляем при каждом изменении строки
  emailVerified         Boolean   @default(false)       // флаг подтверждения email
  verificationTokenHash String?   @unique               // хэш (SHA-256) токена верификации
  verificationExpiresAt DateTime?                       // срок действия токена
  trips     Trip[]                                      // связь с поездками (пользователь может владеть множеством поездок)
}

// Таблица Trip (поездки)
model Trip {
  id            Int @id @default(autoincrement())                  // первичный ключ
  title         String                                             // название поездки (например "Тюмень - Санкт-Петербург")
  startDate     DateTime                                           // дата и время начала
  endDate       DateTime                                           // дата и время окончания
  status        String @default("active")                          // статус (active - активна, completed - завершена, cancelled - отменена)
  userId        Int                                                // внешний ключ того, кто создал поездку (владелец)
  user          User @relation(fields: [userId], references: [id]) // связь с таблицей User
  createdAt     DateTime @default(now())                           // дата создания записи
  updatedAt      DateTime @updatedAt                               // дата последнего обновления

  // Здесь будут связи с другими таблицами
}