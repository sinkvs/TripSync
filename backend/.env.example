# Строка подключения PostgreSQL
# Формат: postgresql://ИМЯ_ПОЛЬЗОВАТЕЛЯ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ?schema=public
DATABASE_URL="postgresql://postgres:пароль@localhost:5432/имя_базы?schema=public"

# Секретный ключ для JWT
JWT_SECRET="ваш_секретный_ключ_здесь"

# Адрес фронтенда
FRONTEND_URL=http://localhost:5173

# Адрес бэкенда
BACKEND_URL=http://localhost:5000

# Порт сервера (можно оставить 5000 или изменить)
PORT=5000

# Ключ шифрования документов
ENCRYPTION_KEY="ваш_ключ_шифрования_здесь"

# Ключ OpenWeatherMap (Geocoding + Current Weather API)
# Получить на https://openweathermap.org/api
WEATHER_API_KEY="your_api_key_here"